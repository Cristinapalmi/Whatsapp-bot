# ============================================================
#  VARIÁVEIS DE AMBIENTE — copia este ficheiro para ".env"
#  e preenche os valores. NUNCA publiques o ficheiro .env.
# ============================================================

# --- Base de dados (Supabase → Project Settings → Database → Connection string) ---
# DATABASE_URL: usa a ligação "Transaction pooler" (porta 6543) e acrescenta ?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app"
# DIRECT_URL: usa a ligação "Session pooler"/direta (porta 5432) — usada para criar as tabelas
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/app"

# --- Segurança das sessões (escreve uma frase longa e aleatória, 32+ caracteres) ---
SESSION_SECRET="muda-isto-para-uma-frase-muito-longa-e-aleatoria-123456"

# --- Marca (ver config/brand.ts) ---
NEXT_PUBLIC_BRAND_NAME="KONTA"
NEXT_PUBLIC_BRAND_SLOGAN="Minisséries angolanas que te prendem"
NEXT_PUBLIC_BRAND_DOMAIN="localhost:3000"
NEXT_PUBLIC_BRAND_COLOR_ACCENT="#FF7A2F"
NEXT_PUBLIC_BRAND_COLOR_ACCENT2="#FFB547"
NEXT_PUBLIC_BRAND_SUPPORT_EMAIL="apoio@exemplo.ao"
NEXT_PUBLIC_BRAND_SUPPORT_WHATSAPP="+244 900 000 000"

# --- Dados do pagamento manual (aparecem no ecrã de pagamento) ---
PAYMENT_MCX_NUMBER="9XX XXX XXX"
PAYMENT_IBAN="AO06 0000 0000 0000 0000 0000 0"
PAYMENT_ACCOUNT_HOLDER="Nome do titular"
PAYMENT_BANK_NAME="Banco"

# --- Regras de negócio (opcional; ver config/business.ts) ---
ARTIST_SHARE_PERCENT=50
MIN_WITHDRAWAL_KZ=5000
MAX_PENDING_PAYMENTS_PER_USER=3

# --- Armazenamento de ficheiros (vídeos, capas, comprovativos) ---
# "local" = guarda na pasta ./storage do teu computador (só para testes)
# "s3"    = Cloudflare R2 (recomendado online)
STORAGE_DRIVER="local"
# Cloudflare R2 → R2 → Manage R2 API Tokens (permissão Object Read & Write)
S3_ENDPOINT=""            # ex.: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_MEDIA=""        # ex.: minisseries-media (vídeos, capas, fotos)
S3_BUCKET_PRIVATE=""      # ex.: minisseries-privado (comprovativos)

# --- Primeira conta de administração (usada pelo seed) ---
ADMIN_PHONE="+244900000001"
ADMIN_PASSWORD="muda-esta-palavra-passe"

# --- Testes automáticos (base de dados separada, é apagada a cada teste) ---
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_test"
