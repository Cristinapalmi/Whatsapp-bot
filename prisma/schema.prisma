// ============================================================
//  Estrutura da base de dados
//  Valores de dinheiro: SEMPRE em cêntimos de Kwanza (inteiros).
//  Ex.: 100 Kz = 10000 cêntimos.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Utilizadores e consentimentos ----------

enum Role {
  PUBLIC
  ARTIST
  ADMIN
}

model User {
  id                 String   @id @default(cuid())
  name               String
  phone              String   @unique // formato normalizado: +2449XXXXXXXX
  email              String?
  passwordHash       String
  birthDate          DateTime
  role               Role     @default(PUBLIC)
  disabled           Boolean  @default(false)
  createdAt          DateTime @default(now())
  /// Artista que trouxe este utilizador (link pessoal) — usado na Fase 2.
  referredByArtistId String?
  /// Último dia (AAAA-MM-DD, Luanda) em que viu a sugestão ao abrir a app (máx. 1 por dia).
  suggestionSeenDay  String?
  /// Quando a oferta de boas-vindas foi mostrada pela 1.ª vez (contagem de 24 h, nunca recomeça).
  welcomeOfferStartedAt DateTime?
  /// Código pessoal de convite de fã (link /convite/CODIGO).
  inviteCode         String?   @unique
  /// Bloqueado nos pontos (batota nos convites): não ganha pontos de convites nem de presença.
  pointsBlocked      Boolean   @default(false)
  /// Lista negra de pagamentos: não pode enviar comprovativos ("Rejeitar e bloquear").
  paymentsBlockedAt  DateTime?
  paymentsBlockedReason String?
  /// Aparelho e ligação usados no registo (só para detetar contas repetidas nos convites).
  signupDeviceId     String?
  signupIp           String?
  /// Autenticação em 2 passos (app de autenticação, TOTP) — obrigatória para a admin.
  totpSecret         String?
  totpEnabled        Boolean  @default(false)
  totpLastStep       Int?
  /// Códigos de recuperação (guardados só como hash; cada um serve uma vez).
  totpRecoveryHashes String[] @default([])

  consents           Consent[]
  artistProfile      ArtistProfile?
  paymentRequests    PaymentRequest[]    @relation("PaymentRequester")
  reviewedPayments   PaymentRequest[]    @relation("PaymentReviewer")
  entitlements       Entitlement[]
  watchProgress      WatchProgress[]
  notifications      Notification[]
  reports            Report[]
  auditLogs          AuditLog[]
  processedPayouts   PayoutRequest[]     @relation("PayoutProcessor")
  weeklyPasses       WeeklyPass[]
  journalEntries     JournalEntry[]
  pointsTransactions PointsTransaction[]
  coinLots           CoinLot[]
  coinSpends         CoinSpend[]
  favorites          Favorite[]
  follows            Follow[]
  invitesSent        FanInvite[] @relation("inviter")
  inviteReceived     FanInvite?  @relation("invitee")
  adViews            AdView[]
  adUnlocks          AdUnlock[]
}

enum ConsentDocument {
  TERMS
  PRIVACY
  ARTIST_SHOW_SERIES // 1. Autorizo mostrar as minhas séries
  ARTIST_FREE_EPISODES // 2. Aceito episódios grátis
  ARTIST_REVENUE_SPLIT // 3. Aceito 50/50, passe e presentes
  ARTIST_CONTENT_RULES // 4. Conteúdo é meu e respeita as regras
  ARTIST_WITHDRAWAL_RULES // 5. Regras de levantamento
}

model Consent {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  document   ConsentDocument
  version    String
  acceptedAt DateTime        @default(now())
  ip         String?
  userAgent  String?

  @@index([userId, document])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  phone     String
  success   Boolean
  /// "login", "register" ou "2fa"
  kind      String   @default("login")
  ip        String?
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
  @@index([ip, createdAt])
}

// ---------- Artistas, séries e episódios ----------

enum ArtistStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum Category {
  TERROR
  COMEDIA
  DRAMA
  MAKAS_FAMILIA
  ROMANCE
  ACAO
  OUTRO
}

model ArtistProfile {
  id              String       @id @default(cuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  stageName       String
  fullName        String
  biNumber        String
  email           String
  socialUrl       String
  category        Category
  photoKey        String?
  slug            String       @unique // link pessoal: dominio/slug
  bio             String?
  status          ArtistStatus @default(APPROVED)
  rejectionReason String?
  approvedAt      DateTime?
  approvedById    String?
  /// Verificação do BI e do IBAN pela administração (exigida antes do primeiro levantamento pago).
  verifiedAt      DateTime?
  verifiedById    String?
  /// Artista Fundador n.º X (os primeiros 20). Ganha mais nos primeiros meses e fica com o selo para sempre.
  founderNumber   Int?         @unique
  /// "Traz um kamba": quem convidou este artista, e quando o bónus do convite foi pago.
  invitedByArtistId   String?
  referralBonusPaidAt DateTime?
  /// Primeira venda (para a notificação "o teu primeiro fã pagou").
  firstSaleAt     DateTime?
  tiktokUrl       String?
  instagramUrl    String?
  createdAt       DateTime     @default(now())

  followers          Follow[]
  series             Series[]
  payoutAccount      PayoutAccount?
  payoutRequests     PayoutRequest[]
  ledgerAccounts     LedgerAccount[]
  paymentRequests    PaymentRequest[]
  watchLogs          WatchLog[]
  referralVisits     ReferralVisit[]
  pointsTransactions PointsTransaction[]
  coinSpends         CoinSpend[]
  adUnlocks          AdUnlock[]
}

enum SeriesStatus {
  DRAFT // rascunho: o artista ainda está a preparar
  IN_REVIEW // enviada pelo artista, em análise
  APPROVED // aprovada, mas ainda sem episódios publicados
  PUBLISHED // visível ao público
  REJECTED
  HIDDEN // retirada (denúncia, pedido do artista, etc.)
}

model Series {
  id               String        @id @default(cuid())
  artistId         String
  artist           ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Restrict)
  title            String
  slug             String        @unique
  synopsis         String        @default("")
  category         Category
  coverKey         String?
  socialUrl        String?
  plannedEpisodes  Int           @default(1)
  /// (antigo) Preço por episódio em cêntimos de Kz — já não é usado na venda.
  priceCents       Int           @default(10000)
  /// Preço por episódio em MOEDAS para esta série. Vazio = preço por defeito (definido no admin).
  priceCoins       Int?
  /// Quantos episódios iniciais são grátis.
  freeEpisodes     Int           @default(3)
  status           SeriesStatus  @default(IN_REVIEW)
  featured         Boolean       @default(false)
  rejectionReason  String?
  createdAt        DateTime      @default(now())
  publishedAt      DateTime?
  /// Trailer vertical (~30 s) para o artista publicar no TikTok/Instagram.
  trailerKey       String?
  trailerUpdatedAt DateTime?
  /// Classificação etária, idioma e etiquetas (escolhidos pelo artista)
  ageRating        AgeRating     @default(ALL)
  /// "PT" = Português; "PT_NATIONAL" = Português + línguas nacionais
  language         String        @default("PT")
  tags             String[]      @default([])
  /// 👑 — a série chegou ao marco mais alto de desbloqueios.
  crownedAt        DateTime?
  /// Nível de preço por episódio (Entrada / Normal / Premium)
  tier             PriceTier     @default(ENTRY)
  /// Série retirada pelo artista: sai logo do catálogo; quem desbloqueou vê 30 dias; depois os ficheiros são apagados
  withdrawnAt      DateTime?
  withdrawReason   String?
  purgedAt         DateTime?

  episodes  Episode[]
  reports   Report[]
  favorites Favorite[]
  coinSpends CoinSpend[]
  milestones SeriesMilestone[]

  @@index([status, category])
}

model Episode {
  id              String        @id @default(cuid())
  seriesId        String
  series          Series        @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  number          Int
  title           String
  synopsis        String?
  /// Vídeo em qualidade baixa (360p) — usado por defeito / modo poupar dados.
  videoKey        String?
  /// Vídeo em qualidade média (480p), opcional.
  videoKeyHd      String?
  /// Legendas em WebVTT (.vtt), opcional.
  subtitlesKey    String?
  durationSec     Int           @default(0)
  /// Marca o episódio que termina em suspense (normalmente o último grátis).
  endsWithHook    Boolean       @default(false)
  hookText        String?
  /// Visível ao público (= status PUBLISHED). Mantido para as consultas existentes.
  published       Boolean       @default(false)
  /// Rascunho → Em revisão → Publicado / Recusado
  status          EpisodeStatus @default(DRAFT)
  rejectionReason String?
  submittedAt     DateTime?
  createdAt       DateTime      @default(now())

  entitlements       Entitlement[]
  watchProgress      WatchProgress[]
  paymentRequests    PaymentRequest[]
  watchLogs          WatchLog[]
  reports            Report[]
  pointsTransactions PointsTransaction[]
  coinSpends         CoinSpend[]
  adViews            AdView[]
  adUnlocks          AdUnlock[]

  @@unique([seriesId, number])
}

// ---------- Pagamentos ----------

enum AgeRating {
  ALL
  AGE13
  AGE16
  AGE18
}

enum PriceTier {
  ENTRY
  NORMAL
  PREMIUM
}

enum EpisodeStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  REJECTED
}

enum PaymentKind {
  EPISODE // (antigo) compra de episódio em Kz — desativado, mantido para o histórico
  WEEKLY_PASS // passe semanal — venda desativada por agora
  GIFT // (antigo) presente em Kz — desativado, mantido para o histórico
  COINS // compra de um pacote de moedas
}

enum PaymentMethod {
  MULTICAIXA_EXPRESS
  BANK_TRANSFER
  PAYPAY
  REFERENCE
}

enum PaymentStatus {
  PENDING // a aguardar confirmação
  CONFIRMED
  REJECTED
  REVERSED // confirmado e depois anulado (ex.: transferência falsa)
}

model PaymentRequest {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation("PaymentRequester", fields: [userId], references: [id])
  kind            PaymentKind
  episodeId       String?
  episode         Episode?       @relation(fields: [episodeId], references: [id])
  /// Artista que recebe os 50% (nulo no passe semanal).
  artistId        String?
  artist          ArtistProfile? @relation(fields: [artistId], references: [id])
  /// Tipo de presente (Fase 2), ex.: "CUCA".
  giftType        String?
  /// Compra de moedas: pacote escolhido e moedas a creditar (cópia no momento do pedido).
  coinPackId      String?
  coins           Int?
  /// Moedas extra da oferta de boas-vindas (já incluídas em "coins").
  bonusCoins      Int            @default(0)
  amountCents     Int
  /// Comissão do prestador de pagamento (0 na fase manual).
  feeCents        Int            @default(0)
  method          PaymentMethod
  /// Prestador que tratou o pagamento: "manual", "multicaixa", ...
  provider        String         @default("manual")
  providerRef     String?
  payerPhone      String?
  /// N.º da operação escrito no comprovativo (normalizado). Único.
  transactionRef  String?        @unique
  proofKey        String?
  /// Impressão digital (SHA-256) do ficheiro do comprovativo. Única.
  proofHash       String?        @unique
  /// Verificação automática do comprovativo: só MARCA como suspeito (nunca confirma nem recusa sozinha).
  suspicious      Boolean        @default(false)
  suspicionReasons String[]      @default([])
  /// Texto lido do comprovativo (OCR) e quando foi verificado.
  ocrText         String?
  proofCheckedAt  DateTime?
  status          PaymentStatus  @default(PENDING)
  rejectionReason String?
  reviewedById    String?
  reviewedBy      User?          @relation("PaymentReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  createdAt       DateTime       @default(now())

  entitlement    Entitlement?
  weeklyPass     WeeklyPass?
  journalEntries JournalEntry[]

  @@index([status, createdAt])
  @@index([userId, status])
}

enum EntitlementSource {
  PAYMENT
  POINTS // desbloqueado com pontos: NÃO gera pagamento ao artista
  ADMIN
  COINS // desbloqueado com moedas: o artista ganha a sua parte do valor real das moedas
  AD // desbloqueado com anúncio (oferta única): conta para o fundo mensal de anúncios
}

model Entitlement {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodeId        String
  episode          Episode           @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  source           EntitlementSource
  paymentRequestId String?           @unique
  paymentRequest   PaymentRequest?   @relation(fields: [paymentRequestId], references: [id])
  /// Gasto de moedas que deu este acesso (episódio ou temporada) — para anular certo.
  coinSpendId      String?
  createdAt        DateTime          @default(now())

  @@unique([userId, episodeId])
  @@index([coinSpendId])
}

/// Passe semanal (Fase 2).
model WeeklyPass {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  startsAt         DateTime
  endsAt           DateTime
  paymentRequestId String         @unique
  paymentRequest   PaymentRequest @relation(fields: [paymentRequestId], references: [id])
  revokedAt        DateTime?

  @@index([userId, endsAt])
}

// ---------- Visualizações ----------

model WatchProgress {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodeId      String
  episode        Episode   @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  secondsWatched Int       @default(0)
  lastPosition   Int       @default(0)
  completed      Boolean   @default(false)
  completedAt    DateTime?
  updatedAt      DateTime  @updatedAt
  createdAt      DateTime  @default(now())

  @@unique([userId, episodeId])
}

/// Segundos vistos por dia/utilizador/episódio. Base para minutos, ranking e divisão do passe.
model WatchLog {
  id        String        @id @default(cuid())
  day       DateTime      @db.Date
  userId    String
  episodeId String
  episode   Episode       @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  artistId  String
  artist    ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)
  seconds   Int           @default(0)
  /// O utilizador tinha passe semanal ativo enquanto viu.
  viaPass   Boolean       @default(false)

  @@unique([day, userId, episodeId, viaPass])
  @@index([artistId, day])
}

// ---------- Livro-razão (dupla entrada) ----------

enum AccountType {
  ASSET // ex.: dinheiro recebido
  LIABILITY // ex.: o que devemos aos artistas
  REVENUE // receita da plataforma
  EXPENSE // ex.: comissões de pagamento
}

model LedgerAccount {
  id        String         @id @default(cuid())
  /// Código único, ex.: "platform:cash", "artist:<id>:available"
  code      String         @unique
  name      String
  type      AccountType
  artistId  String?
  artist    ArtistProfile? @relation(fields: [artistId], references: [id])
  createdAt DateTime       @default(now())

  lines LedgerLine[]
}

model JournalEntry {
  id               String          @id @default(cuid())
  /// Tipo de movimento, ex.: "PAYMENT_CONFIRMED", "PAYOUT_PAID"
  kind             String
  description      String
  /// Evita lançar o mesmo movimento duas vezes.
  idempotencyKey   String          @unique
  paymentRequestId String?
  paymentRequest   PaymentRequest? @relation(fields: [paymentRequestId], references: [id])
  payoutRequestId  String?
  payoutRequest    PayoutRequest?  @relation(fields: [payoutRequestId], references: [id])
  createdById      String?
  createdBy        User?           @relation(fields: [createdById], references: [id])
  createdAt        DateTime        @default(now())

  lines LedgerLine[]
}

/// Cada linha: valor positivo = débito, negativo = crédito.
/// A soma das linhas de cada lançamento é SEMPRE zero.
model LedgerLine {
  id          String        @id @default(cuid())
  entryId     String
  entry       JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Restrict)
  accountId   String
  account     LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  amountCents Int
  createdAt   DateTime      @default(now())

  @@index([accountId, createdAt])
}

// ---------- Levantamentos dos artistas ----------

enum PayoutMethod {
  BANK_IBAN
  MULTICAIXA_EXPRESS
}

model PayoutAccount {
  id         String        @id @default(cuid())
  artistId   String        @unique
  artist     ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)
  holderName String
  method     PayoutMethod
  bankName   String?
  iban       String?
  mcxPhone   String?
  updatedAt  DateTime      @updatedAt
}

enum PayoutStatus {
  PROCESSING // em processamento
  PAID
  REJECTED
}

model PayoutRequest {
  id            String        @id @default(cuid())
  artistId      String
  artist        ArtistProfile @relation(fields: [artistId], references: [id])
  amountCents   Int
  status        PayoutStatus  @default(PROCESSING)
  // Cópia dos dados de pagamento no momento do pedido
  method        PayoutMethod
  holderName    String
  bankName      String?
  iban          String?
  mcxPhone      String?
  requestedAt   DateTime      @default(now())
  processedAt   DateTime?
  processedById String?
  processedBy   User?         @relation("PayoutProcessor", fields: [processedById], references: [id])
  proofKey      String?
  adminNote     String?

  journalEntries JournalEntry[]

  @@index([status, requestedAt])
}

// ---------- Notificações, denúncias, auditoria ----------

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Report {
  id         String       @id @default(cuid())
  reporterId String?
  reporter   User?        @relation(fields: [reporterId], references: [id])
  seriesId   String?
  series     Series?      @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  episodeId  String?
  episode    Episode?     @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  reason     String
  details    String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String
  data       Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
}

// ---------- Fase 2: pontos de fã e link pessoal ----------

/// Pontos de fã. NÃO têm valor monetário e NUNCA entram no livro-razão.
/// Saldo de pontos = soma de `delta` do utilizador.
model PointsTransaction {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Positivo = ganhou; negativo = gastou.
  delta     Int
  /// "EPISODE_COMPLETED" | "REDEEM_EPISODE" | "ADMIN_ADJUST"
  reason    String
  /// Chave única para pontos que só se podem dar uma vez (convites, presença diária).
  refKey    String?        @unique
  episodeId String?
  episode   Episode?       @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  /// Artista do episódio (para o "Fã n.º 1").
  artistId  String?
  artist    ArtistProfile? @relation(fields: [artistId], references: [id], onDelete: SetNull)
  createdAt DateTime       @default(now())

  @@unique([userId, episodeId, reason])
  @@index([artistId, userId])
}

/// Visitas ao link pessoal de cada artista, por dia ("Vieram por ti").
model ReferralVisit {
  id       String        @id @default(cuid())
  artistId String
  artist   ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)
  day      DateTime      @db.Date
  visits   Int           @default(0)

  @@unique([artistId, day])
}

// ---------- Moedas ----------

/// Definições editáveis no admin (ex.: preço por defeito de um episódio em moedas).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Pacotes de moedas à venda na Loja (editáveis no admin).
model CoinPack {
  id        String   @id @default(cuid())
  priceKz   Int
  coins     Int
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

/// Tipos de presente (nome, emoji e preço em moedas editáveis no admin).
model GiftType {
  code       String  @id
  label      String
  emoji      String
  priceCoins Int
  active     Boolean @default(true)
  sortOrder  Int     @default(0)
}

/// Um "lote" de moedas = uma compra confirmada. Guarda o VALOR REAL das moedas
/// (o que foi pago, depois das comissões), para pagar aos artistas corretamente.
/// As moedas não têm prazo, não se transferem e nunca se convertem em dinheiro.
model CoinLot {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentRequestId    String    @unique
  coinsTotal          Int
  coinsRemaining      Int
  /// Valor real total do lote, em cêntimos de Kz (pago − comissões).
  valueCents          Int
  valueRemainingCents Int
  revokedAt           DateTime?
  createdAt           DateTime  @default(now())

  allocations CoinSpendAllocation[]

  @@index([userId, createdAt])
}

/// Um gasto de moedas (desbloquear episódio ou oferecer presente).
model CoinSpend {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "EPISODE", "SEASON" (todos os episódios restantes de uma série) ou "GIFT"
  kind        String
  episodeId   String?
  episode     Episode?      @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  seriesId    String?
  series      Series?       @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  giftCode    String?
  artistId    String
  artist      ArtistProfile @relation(fields: [artistId], references: [id])
  coins       Int
  /// Valor real das moedas gastas (cêntimos de Kz) e a parte do artista.
  valueCents  Int
  artistCents Int
  reversedAt  DateTime?
  createdAt   DateTime      @default(now())

  allocations CoinSpendAllocation[]

  @@index([userId, createdAt])
  @@index([artistId, createdAt])
}

/// De que lote(s) saíram as moedas de cada gasto (primeiro as mais antigas).
model CoinSpendAllocation {
  id         String    @id @default(cuid())
  spendId    String
  spend      CoinSpend @relation(fields: [spendId], references: [id], onDelete: Cascade)
  lotId      String
  lot        CoinLot   @relation(fields: [lotId], references: [id], onDelete: Cascade)
  coins      Int
  valueCents Int

  @@index([lotId])
}

/// "A minha lista" do fã.
model Favorite {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seriesId  String
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, seriesId])
}

// ---------- Anúncios ----------

/// Anúncio "da casa": vídeo curto de um patrocinador, carregado no admin.
model Ad {
  id          String    @id @default(cuid())
  sponsor     String
  title       String?
  videoKey    String?
  durationSec Int       @default(0)
  linkUrl     String?
  active      Boolean   @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  /// Quantas vezes começou a ser visto / foi visto até ao fim.
  impressions Int       @default(0)
  completions Int       @default(0)
  createdAt   DateTime  @default(now())

  views AdView[]
}

/// Uma visualização de anúncio. O tempo é medido no SERVIDOR (início → fim).
model AdView {
  id          String    @id @default(cuid())
  adId        String
  ad          Ad        @relation(fields: [adId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodeId   String
  episode     Episode   @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  unlock AdUnlock?

  @@index([userId, startedAt])
}

/// Oferta única usada: um episódio desbloqueado por anúncio.
/// Guarda o telefone para o limite valer "por número", mesmo que a conta seja apagada.
model AdUnlock {
  id        String        @id @default(cuid())
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  phone     String
  episodeId String
  episode   Episode       @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  artistId  String
  artist    ArtistProfile @relation(fields: [artistId], references: [id])
  /// Anúncio que deu a oferta (fica vazio se a conta for apagada; o registo e o telefone ficam).
  adViewId  String?       @unique
  adView    AdView?       @relation(fields: [adViewId], references: [id], onDelete: SetNull)
  /// Mês (AAAA-MM, Luanda) — base da divisão do fundo de anúncios.
  month     String
  createdAt DateTime      @default(now())

  @@index([phone])
  @@index([month, artistId])
}

/// Receita de anúncios registada pela administração (ex.: o que um patrocinador pagou).
model AdRevenue {
  id          String   @id @default(cuid())
  month       String
  amountCents Int
  sponsor     String?
  description String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([month])
}

/// Marcos de uma série: bónus por desbloqueios pagos (pagos uma única vez) e marcos de ganhos (só aviso).
model SeriesMilestone {
  id         String   @id @default(cuid())
  seriesId   String
  series     Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  /// "UNLOCKS" (bónus em dinheiro) ou "EARNED" (aviso "passou os 10.000 Kz")
  kind       String
  threshold  Int
  bonusCents Int      @default(0)
  createdAt  DateTime @default(now())

  @@unique([seriesId, kind, threshold])
}

/// Fã que segue um artista (recebe aviso de séries e episódios novos).
model Follow {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  artistId  String
  artist    ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([userId, artistId])
  @@index([artistId])
}

/// Convite de fã ("Mano, vê esta série…"). Os pontos só entram se o amigo voltar outro dia e vir outro episódio.
model FanInvite {
  id             String    @id @default(cuid())
  inviterId      String
  inviter        User      @relation("inviter", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeId      String    @unique
  invitee        User      @relation("invitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  /// PENDING (à espera) | VALID (pontos dados) | SUSPICIOUS (para o admin ver) | VOID (anulado) | EXPIRED (não voltou) | LIMIT (passou o limite do mês)
  status         String    @default("PENDING")
  reason         String?
  deviceId       String?
  ip             String?
  firstWatchAt   DateTime?
  firstWatchDay  String?
  returnedAt     DateTime?
  validatedAt    DateTime?
  purchaseBonusAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([inviterId, status])
  @@index([status, createdAt])
}
